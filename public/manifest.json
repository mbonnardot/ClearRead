{
  "manifest_version": 3,
  "name": "ClearRead",
  "version": "2.0.0",
  "description": "Free, open-source dyslexia web & PDF reader with non-destructive typography, Reader View, Bionic bolding, Syllable dots, Focus Masks, and synchronized speech.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "styles/*.css",
        "onboarding.html",
        "pdf.html",
        "pdf.worker.min.mjs",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "ClearRead",
  "version": "1.0.0",
  "description": "Free, open-source dyslexia reader with typography presets, reading ruler, and word-synchronized text-to-speech.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "onboarding.html"],
      "matches": ["<all_urls>"]
    }
  ]
}

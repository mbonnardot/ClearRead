    "@types/chrome": "^0.0.278",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.4.1",
    "pdfjs-dist": "^5.3.93"
